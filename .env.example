# ─────────────────────────────────────────────────────────────────────────────
# PROJECT 5: GOVERNANCE & SERVING LAYER ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# This file contains the secure credentials and environment configuration for 
# the Docker services. DO NOT commit the real `.env` file to version control.
# Instead, commit `.env.example`.
# ─────────────────────────────────────────────────────────────────────────────

# ── MARQUEZ (POSTGRES BACKEND) ──
MARQUEZ_POSTGRES_USER=marquez
MARQUEZ_POSTGRES_PASSWORD=change_this_postgres_password

# ── SUPERSET (BI / DASHBOARDS) ──
# SUPERSET_SECRET_KEY must be a long random string (e.g. generated via `openssl rand -base64 42`)
SUPERSET_SECRET_KEY=change_this_secret_key_for_production
# Superset Initial Admin Login
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_this_superset_password

# ── AIRFLOW (ORCHESTRATION) ──
# Secret key used to sign session cookies (prevents CSRF mismatch on restarts)
AIRFLOW__WEBSERVER__SECRET_KEY=change_this_airflow_secret_key
# Constant admin login for the Airflow Standalone UI
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_this_airflow_password

# ── CLICKHOUSE (DATA WAREHOUSE) ──
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_this_clickhouse_password
